# §9.11/§25.1 — Health Connect をローカルで有効にするためのテンプレート。
#
# `cp .env.local.example .env.local` で「HC 有効」になる（下の行が `=1`
# のため）。`.env.local` は gitignore 済み・個人用。
#
# ローカルの `expo run:android`/`expo start`（eas.json を経由しない）は
# 既定で Health Connect 無効（without-health-connect 相当）。このファイル
# 無しでは HC 関連の Settings 行・機能は出ない。
#
# 注意: dev-client 経由のライブリロードでは shell export だけでは反映
# されない（CLAUDE.md 参照）。このファイル経由なら反映される。
EXPO_PUBLIC_HEALTH_CONNECT_ENABLED=1
