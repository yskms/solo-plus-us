{
  "expo": {
    "name": "Solo + Us",
    "slug": "solo-plus-us",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "soloplusus",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F8F7FA",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.yskms.soloplusus",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Solo + Us uses Face ID to unlock the app so your records stay private."
      }
    },
    "android": {
      "package": "com.yskms.soloplusus",
      "adaptiveIcon": {
        "backgroundColor": "#F8F7FA",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F8F7FA"
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "expo-document-picker",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Solo + Us uses Face ID to unlock the app so your records stay private."
        }
      ],
      "./plugins/withAndroidNoBackup.js",
      "./plugins/withoutScreenCaptureDetectionPermissions.js",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
