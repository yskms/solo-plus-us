{
  "expo": {
    "name": "Solo + Us",
    "slug": "solo-plus-us",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "soloplusus",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F8F7FA",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.yskms.soloplusus",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Solo + Us uses Face ID to unlock the app so your records stay private."
      }
    },
    "android": {
      "package": "com.yskms.soloplusus",
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#F8F7FA",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 2
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F8F7FA"
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "expo-document-picker",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Solo + Us uses Face ID to unlock the app so your records stay private."
        }
      ],
      "./plugins/withAndroidNoBackup.js",
      "./plugins/withoutScreenCaptureDetectionPermissions.js",
      "./plugins/withAndroidNightColors.js",
      "expo-localization",
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "542e51b9-e435-4e7d-9175-6c77981810b8"
      }
    },
    "owner": "yskms"
  }
}
